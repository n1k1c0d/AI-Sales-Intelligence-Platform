COMPOSE_PROJECT_NAME=dealmind

# Loopback-only host ports. Container ports are fixed.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5433
N8N_HOST_PORT=5678

POSTGRES_DB=dealmind
POSTGRES_USER=dealmind
# Generate two independent random values in your local .env before startup.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=UTC
TZ=UTC
